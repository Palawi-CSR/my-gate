# My Gate configuration, shared by backend/ and frontend/.
# Never commit .env; .env.example is the template to copy.

# --- Backend (FastAPI) ---------------------------------------------
# MongoDB connection string and database name (both required).
MONGODB_URI=
MONGODB_DB_NAME=
# Port the API listens on (8000 is used by the Palawi CSR API).
API_PORT=8001
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Frontend (Vite) -----------------------------------------------
# Port for `npm run dev`. The dev server forwards /api and /files to API_PORT.
WEB_PORT=5180
# Production only: the API's origin when it is not served from the frontend's domain.
# Only variables starting with VITE_ reach the browser, so never put secrets in them.
VITE_API_BASE_URL=
