# My Gate configuration for LOCAL development, shared by backend/ and frontend/.
# Never commit .env; .env.example is the template to copy.
# On Vercel, this file is not used: set MONGODB_URI and MONGODB_DB_NAME under
# Project Settings -> Environment Variables instead (nothing else is needed there).

# --- Backend (FastAPI) ---------------------------------------------
# MongoDB connection string and database name (both required).
MONGODB_URI=
MONGODB_DB_NAME=
# Local only: port the API listens on (8000 is used by the Palawi CSR API).
API_PORT=8001
# Origins allowed to call the API from another domain (not needed on Vercel).
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Frontend (Vite) -----------------------------------------------
# Local only: port for `npm run dev`. The dev server forwards /api to API_PORT.
WEB_PORT=5180
# Leave empty (Vercel serves the API on the same domain). Only set it if the API
# is ever hosted on a different domain.
# Only variables starting with VITE_ reach the browser, so never put secrets in them.
VITE_API_BASE_URL=
