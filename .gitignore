node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Backend
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
backend/scripts/gate_register_backup.json
backend/storage/
